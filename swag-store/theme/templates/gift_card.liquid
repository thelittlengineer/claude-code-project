{% layout none %}

<!doctype html>
<html lang="{{ request.locale.iso_code }}">
  <head>
    <script src="{{ 'vendor/qrcode.js' | shopify_asset_url }}" defer></script>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="theme-color" content="{{ settings.color_background }}">
    <link rel="canonical" href="{{ canonical_url }}">
    <link rel="preconnect" href="https://fonts.shopifycdn.com" crossorigin>

    {%- assign formatted_balance = gift_card.balance | money_without_trailing_zeros | strip_html -%}
    <title>{{ 'gift_cards.issued.title' | t: value: formatted_balance, shop: shop.name }}</title>
    <meta name="description" content="{{ 'gift_cards.issued.subtext' | t }}">

    {{ content_for_header }}

    {% render 'theme-styles' %}
    {{ 'base.css' | asset_url | stylesheet_tag }}
  </head>

  <body class="template-gift-card">
    <main class="gift-card">
      <div class="gift-card__card pattern">
        {%- if settings.logo != blank -%}
          {{ settings.logo | image_url: width: 400 | image_tag: class: 'gift-card__logo', alt: shop.name }}
        {%- else -%}
          {% render 'swag-wordmark', id: 'gift-card', class: 'gift-card__wordmark' %}
        {%- endif -%}
        <p class="gift-card__balance h1">
          {%- if settings.currency_code_enabled -%}
            {{ gift_card.balance | money_with_currency }}
          {%- else -%}
            {{ gift_card.balance | money }}
          {%- endif -%}
        </p>
        {%- if gift_card.enabled == false or gift_card.expired -%}
          <span class="tag">{{ 'gift_cards.issued.expired' | t }}</span>
        {%- endif -%}
      </div>

      {%- if gift_card.expires_on -%}
        {%- assign expires_on = gift_card.expires_on | date: '%B %e, %Y' -%}
        <p class="eyebrow">{{ 'gift_cards.issued.expiration_date' | t: expires_on: expires_on }}</p>
      {%- endif -%}

      <p>{{ 'gift_cards.issued.how_to_use_gift_card' | t }}</p>
      <p class="gift-card__code" id="GiftCardCode">{{ gift_card.code | format_code }}</p>
      <div class="gift-card__qr" data-identifier="{{ gift_card.qr_identifier }}"></div>

      {%- if gift_card.pass_url -%}
        <a href="{{ gift_card.pass_url }}" class="gift-card__wallet">
          <img
            src="{{ 'gift-card/add-to-apple-wallet.svg' | shopify_asset_url }}"
            width="120"
            height="40"
            alt="{{ 'gift_cards.issued.add_to_apple_wallet' | t }}"
            loading="lazy"
          >
        </a>
      {%- endif -%}

      <div class="gift-card__buttons">
        <button type="button" class="button" data-copy-code>{{ 'gift_cards.issued.copy_code' | t }}</button>
        <a href="{{ shop.url }}" class="button button--outline">{{ 'gift_cards.issued.shop_link' | t }}</a>
        <button type="button" class="button button--outline" onclick="window.print();">{{ 'gift_cards.issued.print_gift_card' | t }}</button>
      </div>
      <p class="gift-card__copied" role="status" hidden>{{ 'gift_cards.issued.copy_code_success' | t }}</p>
    </main>

    <script>
      document.addEventListener('DOMContentLoaded', function () {
        var qr = document.querySelector('.gift-card__qr');
        if (qr && window.QRCode) {
          new QRCode(qr, { text: qr.dataset.identifier, width: 120, height: 120 });
        }
        var copy = document.querySelector('[data-copy-code]');
        if (copy && navigator.clipboard) {
          copy.addEventListener('click', function () {
            navigator.clipboard.writeText({{ gift_card.code | json }}).then(function () {
              document.querySelector('.gift-card__copied').hidden = false;
            });
          });
        }
      });
    </script>
  </body>
</html>
