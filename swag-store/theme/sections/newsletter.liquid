{%- assign s = section.settings -%}

<section class="section">
  <div class="page-width">
    <div class="newsletter scheme-{{ s.color_scheme }}">
      <div class="newsletter__art pattern pattern--bold" aria-hidden="true"></div>
      <div class="newsletter__inner">
        {%- if s.eyebrow != blank -%}
          <p class="eyebrow">{{ s.eyebrow | escape }}</p>
        {%- endif -%}
        {%- if s.heading != blank -%}
          <h2 class="h2">{{ s.heading | escape }}</h2>
        {%- endif -%}
        {%- if s.text != blank -%}
          <div class="rte newsletter__text">{{ s.text }}</div>
        {%- endif -%}

        {%- form 'customer', id: 'NewsletterForm', class: 'newsletter__form' -%}
          <input type="hidden" name="contact[tags]" value="newsletter">
          <div class="field field--inline">
            <label class="visually-hidden" for="NewsletterForm-email">{{ 'newsletter.label' | t }}</label>
            <input
              id="NewsletterForm-email"
              type="email"
              name="contact[email]"
              class="field__input"
              value="{{ form.email }}"
              autocorrect="off"
              autocapitalize="off"
              autocomplete="email"
              placeholder="{{ 'newsletter.label' | t }}"
              required
              {% if form.errors %}aria-invalid="true" aria-describedby="NewsletterForm-error"{% endif %}
            >
            <button type="submit" class="button" name="commit">
              {{ 'newsletter.button_label' | t }}
            </button>
          </div>
          {%- if form.errors -%}
            <p id="NewsletterForm-error" class="form-message form-message--error">{{ form.errors.translated_fields.email | capitalize }} {{ form.errors.messages.email }}</p>
          {%- elsif form.posted_successfully? -%}
            <p class="form-message form-message--success" tabindex="-1" autofocus>{{ 'newsletter.success' | t }}</p>
          {%- endif -%}
        {%- endform -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Newsletter",
  "class": "section-newsletter",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "The list"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Join the crew"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>First dibs on every drop, restock alerts, and nothing you didn't ask for.</p>"
    },
    {
      "type": "select",
      "id": "color_scheme",
      "label": "Color scheme",
      "options": [
        { "value": "dark", "label": "Dark" },
        { "value": "lime", "label": "Lime" }
      ],
      "default": "dark"
    }
  ],
  "presets": [
    {
      "name": "Newsletter"
    }
  ]
}
{% endschema %}
