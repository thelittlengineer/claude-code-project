{%- assign s = section.settings -%}

<product-recommendations
  class="section scheme-{{ s.color_scheme }}"
  data-url="{{ routes.product_recommendations_url }}?section_id={{ section.id }}&product_id={{ product.id }}&limit={{ s.products_to_show }}&intent=related"
>
  {%- if recommendations.performed? and recommendations.products_count > 0 -%}
    <div class="page-width">
      {% render 'section-heading', eyebrow: s.eyebrow, heading: s.heading %}
      <ul class="product-grid product-grid--4" role="list">
        {%- for recommendation in recommendations.products -%}
          <li>{% render 'product-card', product: recommendation %}</li>
        {%- endfor -%}
      </ul>
    </div>
  {%- endif -%}
</product-recommendations>

{% schema %}
{
  "name": "Product recommendations",
  "class": "section-product-recommendations",
  "settings": [
    {
      "type": "paragraph",
      "content": "Recommendations are picked automatically from your orders and product descriptions."
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Pairs well with"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "You may also like"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "min": 2,
      "max": 8,
      "step": 1,
      "label": "Products to show",
      "default": 4
    },
    {
      "type": "select",
      "id": "color_scheme",
      "label": "Color scheme",
      "options": [
        { "value": "dark", "label": "Dark" },
        { "value": "lime", "label": "Lime" }
      ],
      "default": "dark"
    }
  ]
}
{% endschema %}
