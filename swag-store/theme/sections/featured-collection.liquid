{%- liquid
  assign s = section.settings
  assign collection = s.collection
  assign columns = s.columns_desktop
  assign view_all_label = 'sections.featured_collection.view_all' | t
  if collection != blank and s.show_view_all
    assign view_all_url = collection.url
  else
    assign view_all_url = ''
  endif
  case columns
    when 2
      assign sizes = '(min-width: 990px) 50vw, 50vw'
    when 3
      assign sizes = '(min-width: 990px) 33vw, 50vw'
    else
      assign sizes = '(min-width: 990px) 25vw, (min-width: 750px) 33vw, 50vw'
  endcase
-%}

<section class="section scheme-{{ s.color_scheme }}">
  <div class="page-width">
    {% render 'section-heading',
      eyebrow: s.eyebrow,
      heading: s.heading,
      link_url: view_all_url,
      link_label: view_all_label
    %}

    <ul class="product-grid product-grid--{{ columns }}" role="list">
      {%- if collection != blank and collection.products_count > 0 -%}
        {%- for product in collection.products limit: s.products_to_show -%}
          <li>{% render 'product-card', product: product, sizes: sizes %}</li>
        {%- endfor -%}
      {%- else -%}
        {%- for i in (1..s.products_to_show) -%}
          <li>{% render 'product-card', placeholder_index: i, sizes: sizes %}</li>
        {%- endfor -%}
      {%- endif -%}
    </ul>
  </div>
</section>

{% schema %}
{
  "name": "Featured collection",
  "class": "section-featured-collection",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Drop 001"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "New arrivals"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "min": 2,
      "max": 16,
      "step": 1,
      "label": "Products to show",
      "default": 8
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "min": 2,
      "max": 5,
      "step": 1,
      "label": "Columns on desktop",
      "default": 4
    },
    {
      "type": "checkbox",
      "id": "show_view_all",
      "label": "Show \"View all\" link",
      "default": true
    },
    {
      "type": "select",
      "id": "color_scheme",
      "label": "Color scheme",
      "options": [
        { "value": "dark", "label": "Dark" },
        { "value": "lime", "label": "Lime" }
      ],
      "default": "dark"
    }
  ],
  "presets": [
    {
      "name": "Featured collection"
    }
  ]
}
{% endschema %}
