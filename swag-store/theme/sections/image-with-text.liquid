{%- assign s = section.settings -%}

<section class="section scheme-{{ s.color_scheme }}">
  <div class="page-width">
    <div class="image-with-text image-with-text--{{ s.image_position }}">
      <div class="image-with-text__media ratio ratio--portrait">
        {%- if s.image != blank -%}
          {{
            s.image
            | image_url: width: 1400
            | image_tag:
              loading: 'lazy',
              widths: '450, 750, 1000, 1400',
              sizes: '(min-width: 990px) 50vw, 100vw',
              class: 'image-with-text__image',
              alt: s.image.alt
          }}
        {%- else -%}
          {{ 'lifestyle-1' | placeholder_svg_tag: 'image-with-text__image placeholder-svg' }}
        {%- endif -%}
      </div>

      <div class="image-with-text__content">
        {%- if s.eyebrow != blank -%}
          <p class="eyebrow">{{ s.eyebrow | escape }}</p>
        {%- endif -%}
        {%- if s.heading != blank -%}
          <h2 class="h2">{{ s.heading | escape }}</h2>
        {%- endif -%}
        {%- if s.text != blank -%}
          <div class="rte image-with-text__text">{{ s.text }}</div>
        {%- endif -%}
        {%- if s.show_signoff -%}
          <div class="signoff">
            <span class="signoff__label">{{ 'sections.image_with_text.signed' | t }}</span>
            {% render 'swag-wordmark', id: section.id, class: 'signoff__wordmark', animate: true %}
          </div>
        {%- endif -%}
        {%- if s.button_label != blank -%}
          <a href="{{ s.button_link | default: routes.all_products_collection_url }}" class="button button--outline">
            {{ s.button_label | escape }}
            {% render 'icon', icon: 'arrow' %}
          </a>
        {%- endif -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Image with text",
  "class": "section-image-with-text",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "select",
      "id": "image_position",
      "label": "Image position",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "right", "label": "Right" }
      ],
      "default": "left"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "The story"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Every piece, patterned"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>SWAG started as a doodle in the margins: loops inside loops, lime on black. Every piece carries that pattern — heavyweight cotton, relaxed cuts, and runs small enough that you won't see yourself coming down the street.</p>"
    },
    {
      "type": "checkbox",
      "id": "show_signoff",
      "label": "Sign off with the wordmark",
      "default": true
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "About us"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "select",
      "id": "color_scheme",
      "label": "Color scheme",
      "options": [
        { "value": "dark", "label": "Dark" },
        { "value": "lime", "label": "Lime" }
      ],
      "default": "dark"
    }
  ],
  "presets": [
    {
      "name": "Image with text"
    }
  ]
}
{% endschema %}
