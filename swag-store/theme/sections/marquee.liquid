<section class="marquee-section scheme-{{ section.settings.color_scheme }}{% if section.settings.tilt %} marquee-section--tilt{% endif %}">
  {% render 'marquee', blocks: section.blocks, speed: section.settings.speed, size: 'large', reverse: section.settings.reverse %}
</section>

{% schema %}
{
  "name": "Scrolling text",
  "tag": "div",
  "class": "section-marquee",
  "max_blocks": 8,
  "settings": [
    {
      "type": "range",
      "id": "speed",
      "min": 10,
      "max": 80,
      "step": 2,
      "unit": "s",
      "label": "Scroll duration",
      "default": 36
    },
    {
      "type": "checkbox",
      "id": "reverse",
      "label": "Scroll the other way",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "tilt",
      "label": "Tilt the strip",
      "default": false
    },
    {
      "type": "select",
      "id": "color_scheme",
      "label": "Color scheme",
      "options": [
        { "value": "grey", "label": "Star grey" },
        { "value": "ink", "label": "Ink" }
      ],
      "default": "ink"
    }
  ],
  "blocks": [
    {
      "type": "text",
      "name": "Text",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "New drop"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Scrolling text",
      "blocks": [
        { "type": "text", "settings": { "text": "New drop" } },
        { "type": "text", "settings": { "text": "Signed, sealed, delivered" } },
        { "type": "text", "settings": { "text": "Limited runs" } }
      ]
    }
  ]
}
{% endschema %}
