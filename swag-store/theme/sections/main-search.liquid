<section class="section section--tight">
  <div class="page-width">
    <div class="search-page__header">
      <p class="eyebrow">{{ 'general.search.search' | t }}</p>
      <h1 class="h1">
        {%- if search.performed -%}
          {{ 'general.search.results_for' | t: terms: search.terms }}
        {%- else -%}
          {{ 'general.search.title' | t }}
        {%- endif -%}
      </h1>
      <form action="{{ routes.search_url }}" method="get" role="search" class="search-form search-form--page">
        <label for="SearchPage-input" class="visually-hidden">{{ 'general.search.search' | t }}</label>
        <input
          id="SearchPage-input"
          class="search-form__input"
          type="search"
          name="q"
          value="{{ search.terms | escape }}"
          placeholder="{{ 'general.search.placeholder' | t }}"
        >
        <input type="hidden" name="options[prefix]" value="last">
        <button type="submit" class="search-form__submit" aria-label="{{ 'general.search.submit' | t }}">
          {% render 'icon', icon: 'arrow' %}
        </button>
      </form>
    </div>

    {%- if search.performed -%}
      {%- paginate search.results by 24 -%}
        {%- if search.results_count == 0 -%}
          <div class="empty-state">
            {% render 'swag-wordmark', class: 'empty-state__wordmark' %}
            <p class="h3">{{ 'general.search.no_results' | t: terms: search.terms }}</p>
          </div>
        {%- else -%}
          <p class="eyebrow search-page__count">{{ 'general.search.results_count' | t: count: search.results_count }}</p>
          <ul class="product-grid product-grid--4" role="list">
            {%- for item in search.results -%}
              <li>
                {%- if item.object_type == 'product' -%}
                  {% render 'product-card', product: item %}
                {%- else -%}
                  <a href="{{ item.url }}" class="search-result">
                    <span class="tag">{{ item.object_type | capitalize }}</span>
                    <span class="h4">{{ item.title | escape }}</span>
                    <span class="search-result__excerpt">{{ item.content | strip_html | truncatewords: 20 }}</span>
                  </a>
                {%- endif -%}
              </li>
            {%- endfor -%}
          </ul>
          {% render 'pagination', paginate: paginate %}
        {%- endif -%}
      {%- endpaginate -%}
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Search results",
  "class": "section-main-search",
  "settings": []
}
{% endschema %}
