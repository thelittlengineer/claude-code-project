<section class="section section--tight">
  <div class="page-width">
    <div class="section-heading">
      <div>
        <p class="eyebrow">{% render 'icon', icon: 'star' %} {{ 'blogs.eyebrow' | t }}</p>
        <h1 class="h1">{{ blog.title | escape }}</h1>
      </div>
    </div>

    {%- paginate blog.articles by 9 -%}
      <ul class="article-grid" role="list">
        {%- for article in blog.articles -%}
          <li>
            <a href="{{ article.url }}" class="article-card">
              <div class="article-card__media ratio ratio--landscape stars stars--bold">
                {%- if article.image -%}
                  {{
                    article.image
                    | image_url: width: 1000
                    | image_tag:
                      loading: 'lazy',
                      widths: '450, 750, 1000',
                      sizes: '(min-width: 990px) 33vw, 100vw',
                      class: 'article-card__image',
                      alt: article.image.alt
                  }}
                {%- endif -%}
              </div>
              <p class="eyebrow">{{ article.published_at | time_tag: format: 'date' }}</p>
              <h2 class="h4">{{ article.title | escape }}</h2>
              <p class="article-card__excerpt">
                {%- if article.excerpt != blank -%}
                  {{ article.excerpt | strip_html | truncatewords: 24 }}
                {%- else -%}
                  {{ article.content | strip_html | truncatewords: 24 }}
                {%- endif -%}
              </p>
            </a>
          </li>
        {%- endfor -%}
      </ul>
      {% render 'pagination', paginate: paginate %}
    {%- endpaginate -%}
  </div>
</section>

{% schema %}
{
  "name": "Blog posts",
  "class": "section-main-blog",
  "settings": []
}
{% endschema %}
