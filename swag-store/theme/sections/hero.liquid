{%- assign s = section.settings -%}

<section class="hero hero--{{ s.layout }} hero--{{ s.height }}">
  <div class="{% if s.layout == 'card' %}page-width{% endif %}">
    <div class="hero__card scheme-{{ s.color_scheme }}" style="--wordmark-width: {{ s.wordmark_width }}%;">
      <div class="hero__pattern">
        {%- if s.image != blank -%}
          {%- liquid
            if section.index == 1
              assign loading = 'eager'
            else
              assign loading = 'lazy'
            endif
          -%}
          {{
            s.image
            | image_url: width: 2400
            | image_tag:
              class: 'hero__image',
              loading: loading,
              sizes: '100vw',
              widths: '750, 1100, 1500, 1800, 2400',
              alt: s.image.alt
          }}
        {%- endif -%}
      </div>

      <div class="hero__band">
        {%- if s.eyebrow != blank -%}
          <p class="eyebrow hero__eyebrow">
            {{ s.eyebrow | escape }}
          </p>
        {%- endif -%}

        {%- if s.show_wordmark -%}
          {% render 'swag-wordmark', class: 'hero__wordmark', animate: s.animate_wordmark %}
        {%- endif -%}

        {%- if s.heading != blank -%}
          <h2 class="hero__heading h1">{{ s.heading | escape }}</h2>
        {%- endif -%}

        {%- if s.text != blank -%}
          <div class="hero__text rte">{{ s.text }}</div>
        {%- endif -%}

        {%- if s.button_label != blank or s.button_label_2 != blank -%}
          <div class="hero__buttons">
            {%- if s.button_label != blank -%}
              <a href="{{ s.button_link | default: routes.all_products_collection_url }}" class="button">
                {{ s.button_label | escape }}
                {% render 'icon', icon: 'arrow' %}
              </a>
            {%- endif -%}
            {%- if s.button_label_2 != blank -%}
              <a href="{{ s.button_link_2 | default: routes.collections_url }}" class="button button--outline">
                {{ s.button_label_2 | escape }}
              </a>
            {%- endif -%}
          </div>
        {%- endif -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Pattern hero",
  "class": "section-hero",
  "settings": [
    {
      "type": "paragraph",
      "content": "Laid out like the brand card: the lime pattern on top, the wordmark on the band below."
    },
    {
      "type": "select",
      "id": "layout",
      "label": "Layout",
      "options": [
        { "value": "card", "label": "Rounded card" },
        { "value": "full", "label": "Full width" }
      ],
      "default": "card"
    },
    {
      "type": "select",
      "id": "height",
      "label": "Pattern height",
      "options": [
        { "value": "small", "label": "Small" },
        { "value": "medium", "label": "Medium" },
        { "value": "large", "label": "Large" }
      ],
      "default": "large"
    },
    {
      "type": "select",
      "id": "color_scheme",
      "label": "Band color scheme",
      "options": [
        { "value": "dark", "label": "Dark" },
        { "value": "lime", "label": "Lime" }
      ],
      "default": "dark"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image",
      "info": "Optional. Replaces the pattern with a lookbook shot."
    },
    {
      "type": "header",
      "content": "Wordmark"
    },
    {
      "type": "checkbox",
      "id": "show_wordmark",
      "label": "Show swag wordmark",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "animate_wordmark",
      "label": "Reveal the wordmark on page load",
      "default": true
    },
    {
      "type": "range",
      "id": "wordmark_width",
      "min": 20,
      "max": 80,
      "step": 5,
      "unit": "%",
      "label": "Wordmark width",
      "default": 40
    },
    {
      "type": "header",
      "content": "Text"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "New season"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Loud by nature"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>Acid-lime streetwear with a pattern you won't miss. Heavyweight tees, hoodies and caps — made in small runs.</p>"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "First button label",
      "default": "Shop the drop"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "First button link"
    },
    {
      "type": "text",
      "id": "button_label_2",
      "label": "Second button label",
      "default": "Lookbook"
    },
    {
      "type": "url",
      "id": "button_link_2",
      "label": "Second button link"
    }
  ],
  "presets": [
    {
      "name": "Pattern hero"
    }
  ]
}
{% endschema %}
