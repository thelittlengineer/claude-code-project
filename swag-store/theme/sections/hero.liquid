{%- liquid
  assign s = section.settings
  assign has_image = false
  if s.image != blank
    assign has_image = true
  endif
-%}

<section class="hero hero--{{ s.layout }} hero--{{ s.height }}{% if section.index == 1 %} hero--first{% endif %}">
  <div class="{% if s.layout == 'card' %}page-width{% endif %}">
    <div
      class="hero__card scheme-{{ s.color_scheme }}{% if s.show_stars %} stars stars--bold{% endif %}{% if has_image %} hero__card--image{% endif %}"
      style="--overlay: {{ s.image_overlay | divided_by: 100.0 }}; --signature-width: {{ s.signature_width }}%;"
    >
      {%- if has_image -%}
        <div class="hero__media">
          {%- liquid
            if section.index == 1
              assign loading = 'eager'
            else
              assign loading = 'lazy'
            endif
          -%}
          {{
            s.image
            | image_url: width: 2400
            | image_tag:
              class: 'hero__image',
              loading: loading,
              sizes: '100vw',
              widths: '750, 1100, 1500, 1800, 2400',
              alt: s.image.alt
          }}
        </div>
      {%- endif -%}

      <div class="hero__content">
        {%- if s.eyebrow != blank -%}
          <p class="eyebrow hero__eyebrow">
            {% render 'icon', icon: 'star' %}
            {{ s.eyebrow | escape }}
            {% render 'icon', icon: 'star' %}
          </p>
        {%- endif -%}

        {%- if s.show_signature -%}
          <div class="hero__signature-wrap">
            {% render 'swag-signature', class: 'hero__signature', animate: s.animate_signature %}
          </div>
        {%- endif -%}

        {%- if s.heading != blank -%}
          <h2 class="hero__heading h1">{{ s.heading | escape }}</h2>
        {%- endif -%}

        {%- if s.text != blank -%}
          <div class="hero__text rte">{{ s.text }}</div>
        {%- endif -%}

        {%- if s.button_label != blank or s.button_label_2 != blank -%}
          <div class="hero__buttons">
            {%- if s.button_label != blank -%}
              <a href="{{ s.button_link | default: routes.all_products_collection_url }}" class="button">
                {{ s.button_label | escape }}
                {% render 'icon', icon: 'arrow' %}
              </a>
            {%- endif -%}
            {%- if s.button_label_2 != blank -%}
              <a href="{{ s.button_link_2 | default: routes.collections_url }}" class="button button--outline">
                {{ s.button_label_2 | escape }}
              </a>
            {%- endif -%}
          </div>
        {%- endif -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Star hero",
  "class": "section-hero",
  "settings": [
    {
      "type": "select",
      "id": "layout",
      "label": "Layout",
      "options": [
        { "value": "card", "label": "Rounded card" },
        { "value": "full", "label": "Full width" }
      ],
      "default": "card"
    },
    {
      "type": "select",
      "id": "height",
      "label": "Height",
      "options": [
        { "value": "small", "label": "Small" },
        { "value": "medium", "label": "Medium" },
        { "value": "large", "label": "Large" },
        { "value": "screen", "label": "Fill screen" }
      ],
      "default": "large"
    },
    {
      "type": "select",
      "id": "color_scheme",
      "label": "Color scheme",
      "options": [
        { "value": "grey", "label": "Star grey" },
        { "value": "ink", "label": "Ink" }
      ],
      "default": "grey"
    },
    {
      "type": "checkbox",
      "id": "show_stars",
      "label": "Show stars",
      "default": true
    },
    {
      "type": "header",
      "content": "Signature"
    },
    {
      "type": "checkbox",
      "id": "show_signature",
      "label": "Show SWAG signature",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "animate_signature",
      "label": "Write the signature on page load",
      "default": true
    },
    {
      "type": "range",
      "id": "signature_width",
      "min": 30,
      "max": 100,
      "step": 5,
      "unit": "%",
      "label": "Signature width",
      "default": 75
    },
    {
      "type": "header",
      "content": "Background image"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image",
      "info": "Optional. A lookbook shot works well; the grey is laid over it so the signature stays readable."
    },
    {
      "type": "range",
      "id": "image_overlay",
      "min": 0,
      "max": 90,
      "step": 5,
      "unit": "%",
      "label": "Overlay opacity",
      "default": 35
    },
    {
      "type": "header",
      "content": "Text"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "New season"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Written in the stars"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>Streetwear signed by hand. Heavyweight tees, hoodies and caps — made in small runs.</p>"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "First button label",
      "default": "Shop the drop"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "First button link"
    },
    {
      "type": "text",
      "id": "button_label_2",
      "label": "Second button label",
      "default": "Lookbook"
    },
    {
      "type": "url",
      "id": "button_link_2",
      "label": "Second button link"
    }
  ],
  "presets": [
    {
      "name": "Star hero"
    }
  ]
}
{% endschema %}
