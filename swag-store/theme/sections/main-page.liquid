<section class="section section--tight">
  <div class="page-width page-width--narrow">
    <p class="eyebrow">{{ shop.name | escape }}</p>
    <h1 class="h1 page__title">{{ page.title | escape }}</h1>
    <div class="rte page__content">{{ page.content }}</div>
  </div>
</section>

{% schema %}
{
  "name": "Page",
  "class": "section-main-page",
  "settings": []
}
{% endschema %}
