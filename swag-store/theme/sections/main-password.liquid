{%- assign s = section.settings -%}

<section class="password pattern pattern--bold">
  <div class="password__inner panel">
    {% render 'swag-wordmark', id: section.id, class: 'password__wordmark', animate: true %}

    {%- if s.heading != blank -%}
      <h1 class="h2">{{ s.heading | escape }}</h1>
    {%- endif -%}

    {%- if shop.password_message != blank -%}
      <p class="password__message">{{ shop.password_message }}</p>
    {%- endif -%}

    {%- form 'customer', id: 'PasswordNewsletter', class: 'newsletter__form' -%}
      <input type="hidden" name="contact[tags]" value="prospect,password page">
      <div class="field field--inline">
        <label class="visually-hidden" for="PasswordNewsletter-email">{{ 'newsletter.label' | t }}</label>
        <input
          id="PasswordNewsletter-email"
          type="email"
          name="contact[email]"
          class="field__input"
          autocomplete="email"
          placeholder="{{ 'newsletter.label' | t }}"
          required
        >
        <button type="submit" class="button" name="commit">{{ 'password.notify' | t }}</button>
      </div>
      {%- if form.posted_successfully? -%}
        <p class="form-message form-message--success">{{ 'password.success' | t }}</p>
      {%- elsif form.errors -%}
        <p class="form-message form-message--error">{{ form.errors.messages.email }}</p>
      {%- endif -%}
    {%- endform -%}

    <details class="password__login">
      <summary class="link-underline">{{ 'password.enter_with_password' | t }}</summary>
      {%- form 'storefront_password', class: 'password__form' -%}
        <div class="field field--inline">
          <label class="visually-hidden" for="Password">{{ 'password.password' | t }}</label>
          <input type="password" name="password" id="Password" class="field__input" autocomplete="current-password" placeholder="{{ 'password.password' | t }}">
          <button type="submit" class="button button--outline">{{ 'password.enter' | t }}</button>
        </div>
        {%- if form.errors -%}
          <p class="form-message form-message--error">{{ form.errors | default_errors }}</p>
        {%- endif -%}
      {%- endform -%}
    </details>

    <p class="password__admin">{{ 'password.admin_link_html' | t }}</p>
  </div>
</section>

{% schema %}
{
  "name": "Password page",
  "class": "section-main-password",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Something new is being signed"
    }
  ]
}
{% endschema %}
