{%- assign s = section.settings -%}

<section class="section scheme-{{ s.color_scheme }}">
  <div class="page-width">
    {%- assign view_all_label = 'sections.collection_list.view_all' | t -%}
    {%- if s.show_view_all -%}
      {%- assign view_all_url = routes.collections_url -%}
    {%- else -%}
      {%- assign view_all_url = '' -%}
    {%- endif -%}
    {% render 'section-heading',
      eyebrow: s.eyebrow,
      heading: s.heading,
      link_url: view_all_url,
      link_label: view_all_label
    %}

    <ul class="collection-grid collection-grid--{{ section.blocks.size | at_most: 4 }}" role="list">
      {%- for block in section.blocks -%}
        {%- liquid
          assign collection = block.settings.collection
          assign image = block.settings.image | default: collection.featured_image
          if collection != blank
            assign title = block.settings.title | default: collection.title
          else
            assign placeholder_title = 'sections.collection_list.placeholder_title' | t
            assign title = block.settings.title | default: placeholder_title
          endif
        -%}
        <li {{ block.shopify_attributes }}>
          <a href="{{ collection.url | default: routes.collections_url }}" class="collection-tile">
            <div class="collection-tile__media ratio ratio--square">
              {%- if image != blank -%}
                {{
                  image
                  | image_url: width: 900
                  | image_tag:
                    loading: 'lazy',
                    widths: '300, 450, 600, 900',
                    sizes: '(min-width: 990px) 25vw, 50vw',
                    class: 'collection-tile__image',
                    alt: title
                }}
              {%- else -%}
                {%- assign illustration = forloop.index | modulo: 4 | plus: 1 -%}
                {%- assign illustration = 'collection-apparel-' | append: illustration -%}
                {{ illustration | placeholder_svg_tag: 'collection-tile__image placeholder-svg' }}
              {%- endif -%}
            </div>
            <div class="collection-tile__label">
              <span class="collection-tile__title">{{ title | escape }}</span>
              {% render 'icon', icon: 'arrow' %}
            </div>
          </a>
        </li>
      {%- endfor -%}
    </ul>
  </div>
</section>

{% schema %}
{
  "name": "Collection list",
  "class": "section-collection-list",
  "max_blocks": 8,
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Shop by"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Category"
    },
    {
      "type": "checkbox",
      "id": "show_view_all",
      "label": "Show \"View all\" link",
      "default": false
    },
    {
      "type": "select",
      "id": "color_scheme",
      "label": "Color scheme",
      "options": [
        { "value": "dark", "label": "Dark" },
        { "value": "lilac", "label": "Lilac" }
      ],
      "default": "dark"
    }
  ],
  "blocks": [
    {
      "type": "collection",
      "name": "Collection",
      "settings": [
        {
          "type": "collection",
          "id": "collection",
          "label": "Collection"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title override"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image override"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Collection list",
      "blocks": [
        { "type": "collection" },
        { "type": "collection" },
        { "type": "collection" },
        { "type": "collection" }
      ]
    }
  ]
}
{% endschema %}
