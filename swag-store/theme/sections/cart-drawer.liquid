{%- comment -%}
  Rendered once from the layout. Also re-rendered through the Section Rendering API after every
  cart change, so the markup here is the single source of truth for the drawer's contents.
{%- endcomment -%}
<cart-drawer class="cart-drawer" data-cart-count-value="{{ cart.item_count }}">
  <div class="cart-drawer__overlay" data-cart-close></div>
  <div
    class="cart-drawer__panel scheme-dark"
    role="dialog"
    aria-modal="true"
    aria-labelledby="CartDrawer-title"
    tabindex="-1"
  >
    <div class="cart-drawer__header">
      <h2 class="h3" id="CartDrawer-title">
        {{ 'cart.title' | t }}
        <span class="cart-drawer__count">({{ cart.item_count }})</span>
      </h2>
      <button type="button" class="header__icon" data-cart-close aria-label="{{ 'accessibility.close' | t }}">
        {% render 'icon', icon: 'close' %}
      </button>
    </div>

    {%- if cart.item_count == 0 -%}
      <div class="cart-drawer__empty pattern">
        {% render 'swag-wordmark', class: 'empty-state__wordmark' %}
        <p class="h3">{{ 'cart.empty' | t }}</p>
        <a href="{{ routes.all_products_collection_url }}" class="button">
          {{ 'cart.continue_shopping' | t }}
          {% render 'icon', icon: 'arrow' %}
        </a>
      </div>
    {%- else -%}
      <ul class="cart-drawer__items" role="list">
        {%- for item in cart.items -%}
          <li class="cart-item cart-item--compact" data-line="{{ forloop.index }}">
            <a href="{{ item.url }}" class="cart-item__media" tabindex="-1" aria-hidden="true">
              {%- if item.image -%}
                {{ item.image | image_url: width: 300 | image_tag: loading: 'lazy', class: 'cart-item__image', alt: item.image.alt }}
              {%- else -%}
                {{ 'product-apparel-1' | placeholder_svg_tag: 'cart-item__image placeholder-svg' }}
              {%- endif -%}
            </a>
            <div class="cart-item__details">
              <a href="{{ item.url }}" class="cart-item__title">{{ item.product.title | escape }}</a>
              {%- unless item.product.has_only_default_variant -%}
                <p class="cart-item__variant">{{ item.variant.title | escape }}</p>
              {%- endunless -%}
              <div class="cart-item__controls">
                <div class="quantity quantity--small">
                  <button class="quantity__button" type="button" data-cart-change="{{ item.quantity | minus: 1 }}" aria-label="{{ 'products.product.quantity.decrease' | t: product: item.product.title | escape }}">
                    {% render 'icon', icon: 'minus' %}
                  </button>
                  <span class="quantity__input" aria-live="polite">{{ item.quantity }}</span>
                  <button class="quantity__button" type="button" data-cart-change="{{ item.quantity | plus: 1 }}" aria-label="{{ 'products.product.quantity.increase' | t: product: item.product.title | escape }}">
                    {% render 'icon', icon: 'plus' %}
                  </button>
                </div>
                <button type="button" class="link-underline cart-item__remove" data-cart-change="0">{{ 'cart.remove' | t }}</button>
              </div>
            </div>
            <div class="cart-item__price">
              {%- if item.original_line_price != item.final_line_price -%}
                <s class="price__compare">{{ item.original_line_price | money }}</s>
              {%- endif -%}
              <span class="price__current">{{ item.final_line_price | money }}</span>
            </div>
          </li>
        {%- endfor -%}
      </ul>

      <div class="cart-drawer__footer">
        {%- for discount in cart.cart_level_discount_applications -%}
          <p class="cart-summary__row">
            <span>{{ discount.title | escape }}</span>
            <span>-{{ discount.total_allocated_amount | money }}</span>
          </p>
        {%- endfor -%}
        <p class="cart-summary__row cart-summary__total">
          <span>{{ 'cart.subtotal' | t }}</span>
          <span>{{ cart.total_price | money_with_currency }}</span>
        </p>
        <p class="cart-summary__note">{{ 'cart.taxes_and_shipping_at_checkout' | t }}</p>
        <form action="{{ routes.cart_url }}" method="post" class="cart-drawer__actions">
          <button type="submit" name="checkout" class="button button--full">
            {{ 'cart.checkout' | t }}
            {% render 'icon', icon: 'arrow' %}
          </button>
          <a href="{{ routes.cart_url }}" class="button button--outline button--full">{{ 'cart.view_cart' | t }}</a>
        </form>
      </div>
    {%- endif -%}
  </div>
</cart-drawer>

{% schema %}
{
  "name": "Cart drawer",
  "settings": []
}
{% endschema %}
