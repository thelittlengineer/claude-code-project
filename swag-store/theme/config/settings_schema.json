[
  {
    "name": "theme_info",
    "theme_name": "SWAG",
    "theme_version": "1.0.0",
    "theme_author": "Mawqi",
    "theme_documentation_url": "https://github.com/thelittlengineer/claude-code-project/tree/main/swag-store",
    "theme_support_url": "https://github.com/thelittlengineer/claude-code-project/issues"
  },
  {
    "name": "Logo",
    "settings": [
      {
        "type": "paragraph",
        "content": "Leave the logo empty to use the built-in \"swag\" wordmark, traced from the green brand card."
      },
      {
        "type": "image_picker",
        "id": "logo",
        "label": "Logo image"
      },
      {
        "type": "range",
        "id": "logo_width",
        "min": 80,
        "max": 300,
        "step": 10,
        "unit": "px",
        "label": "Logo width",
        "default": 140
      },
      {
        "type": "image_picker",
        "id": "favicon",
        "label": "Favicon",
        "info": "32 x 32px .png recommended"
      }
    ]
  },
  {
    "name": "Colors",
    "settings": [
      {
        "type": "color",
        "id": "color_background",
        "label": "Background",
        "info": "The blue-black band from the logo card.",
        "default": "#00070F"
      },
      {
        "type": "color",
        "id": "color_text",
        "label": "Text",
        "default": "#EEF3DA"
      },
      {
        "type": "color",
        "id": "color_accent",
        "label": "Lime",
        "info": "Buttons, highlights and the Lime color scheme.",
        "default": "#BAD406"
      },
      {
        "type": "color",
        "id": "color_black",
        "label": "Pattern black",
        "info": "Text on lime.",
        "default": "#000000"
      },
      {
        "type": "color",
        "id": "color_card",
        "label": "Product image background",
        "default": "#E8E9E2"
      }
    ]
  },
  {
    "name": "Typography",
    "settings": [
      {
        "type": "font_picker",
        "id": "type_header_font",
        "label": "Headings",
        "default": "inter_n7"
      },
      {
        "type": "checkbox",
        "id": "heading_uppercase",
        "label": "Uppercase headings",
        "default": false
      },
      {
        "type": "font_picker",
        "id": "type_body_font",
        "label": "Body",
        "default": "inter_n4"
      },
      {
        "type": "font_picker",
        "id": "type_accent_font",
        "label": "Labels and prices",
        "info": "Used for small tags, prices and buttons.",
        "default": "anonymous_pro_n4"
      }
    ]
  },
  {
    "name": "Pattern",
    "settings": [
      {
        "type": "select",
        "id": "pattern_page",
        "label": "Faint pattern behind the page",
        "options": [
          {
            "value": "none",
            "label": "None"
          },
          {
            "value": "subtle",
            "label": "Subtle"
          }
        ],
        "default": "none"
      }
    ]
  },
  {
    "name": "Layout",
    "settings": [
      {
        "type": "range",
        "id": "page_width",
        "min": 1000,
        "max": 1600,
        "step": 20,
        "unit": "px",
        "label": "Page width",
        "default": 1360
      },
      {
        "type": "range",
        "id": "corner_radius",
        "min": 0,
        "max": 40,
        "step": 2,
        "unit": "px",
        "label": "Corner radius",
        "info": "The brand card uses rounded corners.",
        "default": 16
      }
    ]
  },
  {
    "name": "Product cards",
    "settings": [
      {
        "type": "select",
        "id": "card_image_ratio",
        "label": "Image ratio",
        "options": [
          {
            "value": "portrait",
            "label": "Portrait"
          },
          {
            "value": "square",
            "label": "Square"
          }
        ],
        "default": "portrait"
      },
      {
        "type": "checkbox",
        "id": "card_show_second_image",
        "label": "Show second image on hover",
        "default": true
      },
      {
        "type": "checkbox",
        "id": "card_show_vendor",
        "label": "Show vendor",
        "default": false
      }
    ]
  },
  {
    "name": "Cart",
    "settings": [
      {
        "type": "select",
        "id": "cart_type",
        "label": "Cart type",
        "options": [
          {
            "value": "drawer",
            "label": "Drawer"
          },
          {
            "value": "page",
            "label": "Page"
          }
        ],
        "default": "drawer"
      },
      {
        "type": "checkbox",
        "id": "show_cart_note",
        "label": "Enable cart note",
        "default": false
      }
    ]
  },
  {
    "name": "Social media",
    "settings": [
      {
        "type": "text",
        "id": "social_instagram_link",
        "label": "Instagram",
        "info": "https://instagram.com/yourbrand"
      },
      {
        "type": "text",
        "id": "social_tiktok_link",
        "label": "TikTok",
        "info": "https://tiktok.com/@yourbrand"
      },
      {
        "type": "text",
        "id": "social_x_link",
        "label": "X (Twitter)"
      },
      {
        "type": "text",
        "id": "social_youtube_link",
        "label": "YouTube"
      },
      {
        "type": "text",
        "id": "social_facebook_link",
        "label": "Facebook"
      }
    ]
  },
  {
    "name": "Currency format",
    "settings": [
      {
        "type": "checkbox",
        "id": "currency_code_enabled",
        "label": "Show currency codes",
        "default": false
      }
    ]
  }
]
