  class="signature{% if animate %} signature--animate{% endif %}{% if class != blank %} {{ class }}{% endif %}"
  viewBox="0 0 810 288"
  fill="none"
  stroke="currentColor"
  stroke-width="13.2"
  stroke-linecap="round"
  stroke-linejoin="round"
  role="img"
  aria-label="{{ label | default: shop.name | escape }}"
  xmlns="http://www.w3.org/2000/svg"
